{
  "name": "dimixkoj-construction-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Separate offline-first ConFlow 1 and BuildFlow 1 Windows desktop apps",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:conflow": "cross-env APP_VARIANT=conflow electron .",
    "start:buildflow": "cross-env APP_VARIANT=buildflow electron .",
    "dist:conflow": "cross-env APP_VARIANT=conflow electron-builder --config electron-builder.config.cjs --win nsis --x64",
    "dist:buildflow": "cross-env APP_VARIANT=buildflow electron-builder --config electron-builder.config.cjs --win nsis --x64",
    "dist:both": "npm run dist:conflow && npm run dist:buildflow"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
